# Copy to .env and fill in your keys
OPENAI_API_KEY=sk-...          # Required — LLM (always OpenAI), optional OpenAI ASR/TTS
GEMINI_API_KEY=...             # Required — Gemini ASR/TTS (default providers)

# Optional overrides (defaults shown)
# ASR_PROVIDER=gemini_live     # gemini_live | openai_realtime
# TTS_PROVIDER=gemini          # gemini | openai
