# Copy to .env and fill in your keys
OPENAI_API_KEY=                # OpenAI chat/ASR/TTS benchmarks and app provider
GEMINI_API_KEY=                # Gemini chat/ASR/TTS benchmarks and app provider

# Optional overrides (defaults shown)
# ASR_PROVIDER=gemini_live     # gemini_live | openai_realtime
# TTS_PROVIDER=gemini          # gemini | openai
# OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
# OPENAI_TRANSCRIPTION_MODEL=gpt-realtime-whisper
# GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-latest
# GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts

# Benchmark model lists. Keep comma-separated.
BENCHMARK_OPENAI_CHAT_MODELS=gpt-4.1-nano,gpt-4.1-mini,gpt-4o-mini,gpt-5-nano,gpt-5-mini,gpt-5.2
BENCHMARK_OPENAI_ASR_MODELS=gpt-4o-mini-transcribe,gpt-4o-transcribe,gpt-4o-transcribe-diarize,whisper-1
BENCHMARK_OPENAI_TTS_MODELS=gpt-4o-mini-tts,tts-1,tts-1-hd
BENCHMARK_GEMINI_CHAT_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash,gemini-3.5-flash,gemini-3-flash-preview
BENCHMARK_GEMINI_ASR_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash
BENCHMARK_GEMINI_TTS_MODELS=gemini-2.5-flash-preview-tts
